# Variables d'environnement pour Pet Foster Connect Backend

# Serveur
PORT=3000
API_BASE_URL=http://localhost:3000

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=petfosterconnect
DB_USER=petfosterconnect
DB_PASSWORD=your_password
DB_URL=postgres://petfosterconnect:your_password@localhost:5432/petfosterconnect

# JWT (CHANGER EN PRODUCTION)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Frontend URL (pour CORS)
FRONTEND_URL=http://localhost:5173

# Sécurité (optionnel)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000
